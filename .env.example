# ─── Required on a server (optional locally) ────────────────────────────────
# MongoDB Atlas connection string. Locally, leave it blank and `npm run dev`
# starts a private database in ./.localdb automatically.
# In Atlas, Network Access must allow the hosting servers (0.0.0.0/0 for Vercel).
MONGODB_URI=

# ─── Optional ───────────────────────────────────────────────────────────────
# Session signing key. If blank, a strong key is generated once and stored in the database.
JWT_SECRET=
# Administrator login. This account is created (or repaired: made admin, enabled, password set)
# on every server start, even if other admins exist. To change its password, change it here and redeploy.
# If both are blank, the sign-in page shows a one-time "create administrator" form on an empty database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Shortest password accepted anywhere in the app (default 8).
MIN_PASSWORD_LENGTH=8
# If set, that one-time form also asks for this key (recommended for public deployments).
SETUP_TOKEN=

# ─── Social listening providers (leave blank to run in DEMO mode) ────────────
PDL_API_KEY=
RAPIDAPI_KEY=
# auto = live when both keys are set, otherwise demo. Force with live | demo.
PROVIDER_MODE=auto
PDL_MIN_LIKELIHOOD=6
SOCIAL_LOOKBACK_DAYS=60
SOCIAL_MAX_PAGES=3

# ─── Commute distance ───────────────────────────────────────────────────────
# census = free US Census geocoder. none = only use a "Distance (Miles)" column.
GEOCODER=census
# Default job site if a client has none set in Admin > Clients & users
JOB_SITE_LABEL=
JOB_SITE_LAT=
JOB_SITE_LON=

# ─── Pricing and rules ──────────────────────────────────────────────────────
PRICE_PER_RECORD_CURRENT=2.95
PRICE_PER_RECORD_PREHIRE=0
NEW_USER_CREDITS=0
ENFORCE_MONTHLY_LIMIT=true
ALLOW_SELF_REGISTER=false
# Age is a protected characteristic. Leave false unless counsel approves (see README).
ENABLE_AGE_FACTOR=false
DATA_RETENTION_DAYS=90
MAX_RECORDS_PER_JOB=5000
MAX_ROWS_PER_FILE=20000

# ─── Optional email (notifications, invoices, password reset) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
# Public address of the app, e.g. https://retention.example.com (needed for password-reset links)
APP_URL=

# ─── Optional branding (frontend, read at build time) ───────────────────────
VITE_BRAND_NAME=PrognostiCare
VITE_BRAND_TAGLINE=Turning Data Into Direction.
VITE_PRODUCT_NAME=Staff Retention
VITE_BRAND_LOGO_URL=
VITE_SUPPORT_EMAIL=
